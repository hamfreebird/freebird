// Freebird 语言巡礼
//
// 运行：
//   cargo run -- run examples/tour.fb
// 生成 Stardust 并执行：
//   cargo run -- build --target stardust examples/tour.fb > /tmp/tour.sd
//   ./stardust/stardust-linux-x86_64 /tmp/tour.sd

struct Point {
    x: i64,
    y: i64
}

enum Shape {
    Circle(i64),
    Square(i64),
    Dot
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn divmod(a: i64, b: i64) -> (i64, i64) {
    return a / b, a % b;
}

fn bump(p: &mut i64) {
    *p = *p + 1;
}

fn area(shape: Shape) -> i64 {
    match shape {
        Shape::Circle(r) => 3 * r * r,
        Shape::Square(s) => s * s,
        Shape::Dot => 0,
    }
}

fn main() {
    println_str("== Freebird 语言巡礼 ==");

    // 1. 字符串、Unicode、String 方法与字符输出
    println_str("[1] 字符串 / Unicode / 字符");
    let name = "Freebird";
    let name_len = name.len();
    print_str("你好，");
    print_str(name);
    print_char('!');
    print_char('\n');
    print_str("name.len() = ");
    print(name_len);

    let mut tag: String = String::new();
    tag.push('F');
    tag.push('B');
    print_str("String::new + push -> ");
    print_str(tag);
    print_char('\n');

    // 2. 变量、while 循环、作用域与遮蔽
    println_str("[2] 变量 / while / 作用域遮蔽");
    let mut total = 0;
    let mut i = 0;
    while i < 5 {
        total = total + i;
        i = i + 1;
    }
    print_str("sum(0..4) = ");
    print(total);
    {
        let total = 100;
        print_str("inner total = ");
        print(total);
    }
    print_str("outer total = ");
    print(total);

    // 3. 函数、递归与元组解构
    println_str("[3] 函数 / 递归 / 元组解构");
    print_str("fib(10) = ");
    print(fib(10));
    let (q, r) = divmod(17, 5);
    print_str("17 / 5 = ");
    print(q);
    print_str("17 % 5 = ");
    print(r);

    // 4. 结构体与字段赋值
    println_str("[4] 结构体 / 字段赋值");
    let mut p = Point { x: 3, y: 4 };
    p.x = 10;
    print_str("p.x + p.y = ");
    print(p.x + p.y);

    // 5. 枚举与模式匹配
    println_str("[5] 枚举 / match 模式匹配");
    print_str("Circle(2) area = ");
    print(area(Shape::Circle(2)));
    print_str("Square(3) area = ");
    print(area(Shape::Square(3)));
    print_str("Dot area = ");
    print(area(Shape::Dot));

    // 6. Vec、数组、Box
    println_str("[6] Vec / 数组 / Box");
    let mut v = vec![3, 1, 4];
    v.push(1);
    print_str("v.len() = ");
    print(v.len());
    print_str("v.pop() = ");
    print(v.pop());
    v[0] = 30;
    print_str("v[0] after store = ");
    print(v[0]);
    let arr = [7; 3];
    print_str("array repeat [7;3] sum = ");
    print(arr[0] + arr[2]);
    let boxed = Box::new(6 * 7);
    print_str("*Box::new(6 * 7) = ");
    print(*boxed);

    // 7. 可变引用跨函数写回
    println_str("[7] &mut 引用跨函数写回");
    let mut counter = 41;
    bump(&mut counter);
    print_str("counter after bump = ");
    print(counter);

    // 8. 底层 stardust! 宏
    println_str("[8] stardust! 宏");
    let magic = stardust! { Push(20) Push(22) Add };
    print_str("20 + 22 = ");
    print(magic);

    println_str("== 巡礼结束 ==");
}
